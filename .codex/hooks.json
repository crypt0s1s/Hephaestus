{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/stop-hook-lint.sh\"",
            "timeout": 120,
            "statusMessage": "Running project lint"
          }
        ]
      }
    ]
  }
}
